# CourseLoop 环境配置样例 —— 复制为 .env 后填写。前缀 CL_。
# 未配置 LLM 时后端降级为兜底提示 / 纯检索模式，前端仍可完整演示。

# —— LLM（OpenAI 兼容端点，如智增增 zhizengzeng）——
CL_LLM_BASE_URL=
CL_LLM_API_KEY=
# 四角色模型名（可只填 workhorse）
CL_LLM_WORKHORSE_MODEL=
CL_LLM_EXPERT_MODEL=
CL_LLM_REASONER_MODEL=
# 拍照批改的手写转写模型（多模态）。留空则该页降级提示"未配置"，其余功能不受影响。
CL_LLM_VISION_MODEL=
# 可独立配置视觉端点/密钥，留空沿用统一端点；勿将真实密钥提交仓库。
CL_LLM_VISION_BASE_URL=
CL_LLM_VISION_API_KEY=
CL_LLM_VISION_TEMPERATURE=0.0
# 若文本模型与上面不同供应商，可单独配置：
# CL_LLM_TEXT_BASE_URL=
# CL_LLM_TEXT_API_KEY=

# —— 可选：同一 14B vLLM 上按任务动态切换 LoRA ——
# 仅填 MODEL 时沿用统一文本端点；也可给某任务单独填写 BASE_URL/API_KEY。
# CL_LLM_DIAGNOSE_MODEL=courseloop-diagnose
# CL_LLM_SOLVE_MODEL=courseloop-default
# CL_LLM_GROUNDED_QA_MODEL=courseloop-grounded-qa
# CL_LLM_PRACTICE_MODEL=courseloop-default
# CL_LLM_DIAGNOSE_BASE_URL=http://127.0.0.1:8000/v1
# CL_LLM_DIAGNOSE_API_KEY=local
# CL_LLM_DIAGNOSE_MAX_TOKENS=768
# CL_LLM_SOLVE_MAX_TOKENS=1024
# CL_LLM_GROUNDED_QA_MAX_TOKENS=512
# CL_LLM_PRACTICE_MAX_TOKENS=1024

# —— 检索模式 ——
# vector 使用本地 embedding/reranker；1 核 2G 无卡演示机建议使用 fts5，完全不加载模型。
CL_RAG_MODE=fts5
# CL_RAG_FTS_PATH=/absolute/path/to/data/processed/rag_fts.db

# —— 本地模型（仅 vector 模式需要，建议软链到共享目录）——
# CL_EMBED_MODEL_PATH=/path/to/model/bge-m3
# CL_RERANKER_MODEL_PATH=/path/to/model/bge-reranker-v2-m3
CL_EMBED_DEVICE=auto

# —— 向量库 ——
CL_CHROMA_COLLECTION=courseloop
